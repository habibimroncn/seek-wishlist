generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean?
  locale        String?
  collaborator  Boolean?
  emailVerified Boolean?

  @@index([shop])
}

model Wishlist {
  id         Int      @id @default(autoincrement())

  customerId String

  variantId  String

  createdAt  DateTime @default(now())

  updatedAt  DateTime @updatedAt

  @@unique([customerId, variantId])

  @@index([customerId])
}