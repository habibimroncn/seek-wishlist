generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wishlist {
  id         Int      @id @default(autoincrement())
  shop       String
  customerId String
  variantId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, customerId, variantId])
  @@index([shop, customerId])
}